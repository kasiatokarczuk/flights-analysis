# Configuration format supported by the official apache/hadoop image.
CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.name.dir=file:///data/name
HDFS-SITE.XML_dfs.datanode.data.dir=file:///data/blocks
HDFS-SITE.XML_dfs.replication=1
HADOOP_HEAPSIZE_MAX=512
