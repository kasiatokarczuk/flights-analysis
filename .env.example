# Lokalna MongoDB (kontener mongodb w compose.yaml)
MONGO_DATABASE=flights
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=zmien-to-haslo
MONGO_APP_USER=flights_app
MONGO_APP_PASSWORD=zmien-to-haslo

# MongoDB Atlas: adres połączenia z panelu Atlas (Connect -> Drivers)
ATLAS_URI=mongodb+srv://UZYTKOWNIK:HASLO@cluster0.xxxxx.mongodb.net/
